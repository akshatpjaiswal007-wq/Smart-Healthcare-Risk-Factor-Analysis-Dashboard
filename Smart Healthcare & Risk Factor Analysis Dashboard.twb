      <aliases enabled='yes' />
      <column aggregation='None' caption='BMI range ' datatype='integer' name='[Bmi (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[bmi]' peg='0' size='5' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0257347838689280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &gt;=18 AND [age] &lt;- 30 THEN &quot;Teenager&quot;&#13;&#10;ELSEIF [age] &lt;= 40 THEN &quot;Young Adult&quot;&#13;&#10;ELSEIF [age] &lt;= 50 THEN &quot;Adult&quot;&#13;&#10;ELSEIF [age] &lt;= 60 THEN &quot;Middle Age&quot;&#13;&#10;ELSEIF [age] &lt;= 70 THEN &quot;Senior&quot;&#13;&#10;ELSE &quot;Old&quot;&#13;&#10;END' />
      </column>
      <column caption='Dount axes' datatype='integer' name='[Calculation_0257347873288194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='BMI Category' datatype='string' name='[Calculation_1417057901518849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([bmi]) THEN &quot;Unknown&quot;&#13;&#10;ELSEIF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#13;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#13;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#13;&#10;ELSE &quot;Obese&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Patients' datatype='integer' name='[Calculation_1417057904586755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([age])' />
      </column>
      <column caption='Average Age' datatype='real' name='[Calculation_1417057904754692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([age])' />
      </column>
      <column caption='Average BMI' datatype='real' name='[Calculation_1417057904881669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([bmi])' />
      </column>
      <column caption='Average Health Risk Score' datatype='real' name='[Calculation_1417057905057799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([health_risk_score])' />
      </column>
      <column caption='Heart Disease Patients' datatype='integer' name='[Calculation_1417057905152008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [heart_disease] = 1&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Diabetes Patients' datatype='integer' name='[Calculation_1417057905242121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [diabetes] = 1&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
